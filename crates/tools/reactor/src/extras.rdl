// Extra types needed by windows-reactor but not available in metadata.

#[win32]
mod extras {
    #[guid(0xeecdbf0e_bae9_4cb6_a68e_9598e1cb57bb)]
    interface IWindowNative : Windows::Win32::IUnknown {
        #[special]
        fn get_WindowHandle(&self, hwnd: *mut *mut void) -> HRESULT;
    }

    #[guid(0x63aad0b8_7c24_40ff_85a8_640d944cc325)]
    interface ISwapChainPanelNative : Windows::Win32::IUnknown {
        fn SetSwapChain(&self, swapChain: *mut void) -> HRESULT;
    }

    #[guid(0xcb833102_d5d1_448b_a31a_52a9509f24e6)]
    interface ISurfaceImageSourceNativeWithD2D : Windows::Win32::IUnknown {
        fn SetDevice(&self, device: *mut void) -> HRESULT;
        fn BeginDraw(&self, updateRect: *const Windows::Win32::RECT, iid: *const GUID, updateObject: *mut *mut void, offset: *mut Windows::Win32::POINT) -> HRESULT;
        fn EndDraw(&self) -> HRESULT;
        fn SuspendDraw(&self) -> HRESULT;
        fn ResumeDraw(&self) -> HRESULT;
    }

    // VirtualSurfaceImageSource interop (Microsoft.UI.Xaml WinUI 3 variant).
    //
    // `IVirtualSurfaceImageSourceNative` inherits `ISurfaceImageSourceNative`, so
    // the latter must be declared to lay out the vtable correctly; drawing itself
    // still goes through `ISurfaceImageSourceNativeWithD2D` (cast from the same
    // object), exactly as for the non-virtual surface.
    //
    // GUIDs are the WinUI 3 (microsoft.ui.xaml.media.dxinterop.h) IIDs, which
    // differ from the system (windows.ui.xaml) ones — just as
    // `ISurfaceImageSourceNativeWithD2D` above is `cb833102…` (WinUI 3), not the
    // system `54298223…`.
    #[guid(0xe4cecd6c_f14b_4f46_83c3_8bbda27c6504)]
    interface ISurfaceImageSourceNative : Windows::Win32::IUnknown {
        fn SetDevice(&self, device: *mut void) -> HRESULT;
        fn BeginDraw(&self, updateRect: Windows::Win32::RECT, surface: *mut *mut void, offset: *mut Windows::Win32::POINT) -> HRESULT;
        fn EndDraw(&self) -> HRESULT;
    }

    #[guid(0x9e43c18e_7816_474c_840f_5c9c8b0e2207)]
    interface IVirtualSurfaceImageSourceNative : ISurfaceImageSourceNative {
        fn Invalidate(&self, updateRect: Windows::Win32::RECT) -> HRESULT;
        fn GetUpdateRectCount(&self, count: *mut u32) -> HRESULT;
        fn GetUpdateRects(&self, updates: *mut Windows::Win32::RECT, count: u32) -> HRESULT;
        fn GetVisibleBounds(&self, bounds: *mut Windows::Win32::RECT) -> HRESULT;
        fn RegisterForUpdatesNeeded(&self, callback: *mut void) -> HRESULT;
        fn Resize(&self, newWidth: i32, newHeight: i32) -> HRESULT;
    }

    #[guid(0xe8e84ac7_b7b8_40f4_b033_f877a756c52b)]
    interface IVirtualSurfaceUpdatesCallbackNative : Windows::Win32::IUnknown {
        fn UpdatesNeeded(&self) -> HRESULT;
    }

    // Lifted Microsoft.UI.Composition interop (WinAppSDK 2.1). These are the WinUI 3
    // (microsoft.ui.composition.interop.h) variants — their IIDs differ from the system
    // ABI::Windows::UI::Composition interop interfaces, exactly as
    // ISurfaceImageSourceNativeWithD2D (cb833102…) above is the WinUI 3 IID, not the
    // system 54298223… one. The lifted ICompositorInterop carries ONLY
    // CreateGraphicsDevice (the swap-chain surface factories sit on a separate
    // ICompositorSwapChainInterop), so its vtable is a single method — do NOT copy the
    // system 3-method shape. Used to host an off-XAML-tree, off-thread D2D-drawn
    // composition surface as a child visual of a XAML element.
    #[guid(0xfab19398_6d19_4d8a_b752_8f096c396069)]
    interface ICompositorInterop : Windows::Win32::IUnknown {
        // renderingDevice: an ID2D1Device (for D2D-drawn surfaces) passed as IUnknown*.
        // result: ICompositionGraphicsDevice** (opaque WinRT object) -> *mut *mut void.
        fn CreateGraphicsDevice(&self, renderingDevice: *mut void, result: *mut *mut void) -> HRESULT;
    }

    // Bridges a D2D path geometry into a CompositionPath (the Knob value arc
    // implements this alongside IGeometrySource2D so the compositor can consume
    // its arc). The Win32 metadata generated from the SDK headers does not carry
    // this interop — unlike ICompositorInterop below — so it is declared here.
    #[guid(0x0657af73_53fd_47cf_84ff_c8492d2a80a3)]
    interface IGeometrySource2DInterop : Windows::Win32::IUnknown {
        fn GetGeometry(&self, value: *mut Windows::Win32::ID2D1Geometry) -> HRESULT;
        fn TryGetGeometryUsingFactory(&self, factory: Windows::Win32::ID2D1Factory, value: *mut Windows::Win32::ID2D1Geometry) -> HRESULT;
    }

    // Desktop bridge to Windows.Graphics.Display.DisplayInformation — the WinRT
    // HDR/WCG/SDR capability object. Its public static (GetForCurrentView) needs a
    // UWP CoreWindow this app has none of; the interop factory is the Win32 way in.
    // Not carried by the Win32 metadata this fork bundles (as with
    // IGeometrySource2DInterop above), so it is hand-authored here. It is
    // IInspectable-derived (a WinRT activation-factory interface), not a plain COM
    // interop, so it derives from IInspectable to lay out the three IInspectable
    // slots ahead of its own. GetForWindow/GetForMonitor return a DisplayInformation
    // for a real HWND/HMONITOR, whose AdvancedColorInfoChanged event the dcomp
    // backend subscribes to as the single display-capability-changed signal.
    #[guid(0x7449121c_382b_4705_8da7_a795ba482013)]
    interface IDisplayInformationStaticsInterop : Windows::Win32::IInspectable {
        fn GetForWindow(&self, window: Windows::Win32::HWND, riid: *const GUID, #[iid_is] displayInfo: *mut *mut void) -> HRESULT;
        fn GetForMonitor(&self, monitor: Windows::Win32::HMONITOR, riid: *const GUID, #[iid_is] displayInfo: *mut *mut void) -> HRESULT;
    }

    #[guid(0x2d6355c2_ad57_4eae_92e4_4c3eff65d578)]
    interface ICompositionDrawingSurfaceInterop : Windows::Win32::IUnknown {
        // BeginDraw hands back an ID2D1DeviceContext (pass its IID) already inside a
        // native BeginDraw/EndDraw bracket, plus the atlas offset to translate drawing by.
        fn BeginDraw(&self, updateRect: *const Windows::Win32::RECT, iid: *const GUID, updateObject: *mut *mut void, updateOffset: *mut Windows::Win32::POINT) -> HRESULT;
        fn EndDraw(&self) -> HRESULT;
        fn Resize(&self, sizePixels: Windows::Win32::SIZE) -> HRESULT;
        fn Scroll(&self, scrollRect: *const Windows::Win32::RECT, clipRect: *const Windows::Win32::RECT, offsetX: i32, offsetY: i32) -> HRESULT;
        fn ResumeDraw(&self) -> HRESULT;
        fn SuspendDraw(&self) -> HRESULT;
    }

    // ── Dispatcher-queue creation, re-authored ──
    // These four (CreateDispatcherQueueController + DispatcherQueueOptions + the two
    // thread/apartment enums) live in coremessaging.dll and were carried by the Win32
    // metadata, but an upstream metadata rebase dropped them from BOTH winmds this
    // fork bundles. The dcomp host still needs them to stand up the UI-thread
    // DispatcherQueue that backs the Compositor (and now the DisplayInformation
    // interop), so they are re-authored here. Enum members are bare (no type prefix),
    // matching the Win32 metadata convention, so the generated flat consts stay
    // DQTYPE_THREAD_CURRENT / DQTAT_COM_NONE / … exactly as the host imports them.
    #[repr(i32)]
    enum DISPATCHERQUEUE_THREAD_TYPE {
        DQTYPE_THREAD_DEDICATED = 1,
        DQTYPE_THREAD_CURRENT = 2,
    }

    #[repr(i32)]
    enum DISPATCHERQUEUE_THREAD_APARTMENTTYPE {
        DQTAT_COM_NONE = 0,
        DQTAT_COM_ASTA = 1,
        DQTAT_COM_STA = 2,
    }

    struct DispatcherQueueOptions {
        dwSize: u32,
        threadType: DISPATCHERQUEUE_THREAD_TYPE,
        apartmentType: DISPATCHERQUEUE_THREAD_APARTMENTTYPE,
    }

    #[library("coremessaging.dll")]
    extern fn CreateDispatcherQueueController(
        options: DispatcherQueueOptions,
        dispatcherQueueController: *mut *mut void,
    ) -> HRESULT;

    // Sourced from Microsoft.WindowsAppSDK.Runtime 2.0.1

    #[library("Microsoft.WindowsAppRuntime.Bootstrap.dll")]
    extern fn MddBootstrapInitialize2(
        majorMinorVersion: u32,
        versionTag: *const u16,
        minVersion: Windows::Win32::PACKAGE_VERSION,
        options: MddBootstrapInitializeOptions,
    ) -> HRESULT;
    
    #[library("Microsoft.WindowsAppRuntime.Bootstrap.dll")]
    extern fn MddBootstrapShutdown();
    
    #[repr(i32)]
    enum MddBootstrapInitializeOptions {
        MddBootstrapInitializeOptions_None = 0,
        MddBootstrapInitializeOptions_OnError_DebugBreak = 1,
        MddBootstrapInitializeOptions_OnError_DebugBreak_IfDebuggerAttached = 2,
        MddBootstrapInitializeOptions_OnError_FailFast = 4,
        MddBootstrapInitializeOptions_OnNoMatch_ShowUI = 8,
        MddBootstrapInitializeOptions_OnPackageIdentity_NOOP = 16,
    }

    const WINDOWSAPPSDK_RELEASE_MAJOR: i32 = 2;
    const WINDOWSAPPSDK_RELEASE_MINOR: i32 = 0;
    const WINDOWSAPPSDK_RELEASE_PATCH: i32 = 1;
    const WINDOWSAPPSDK_RELEASE_MAJORMINOR: i32 = 0x0002_0000;

    const WINDOWSAPPSDK_RUNTIME_VERSION_MAJOR: u32 = 2;
    const WINDOWSAPPSDK_RUNTIME_VERSION_MINOR: u32 = 0;
    const WINDOWSAPPSDK_RUNTIME_VERSION_BUILD: u32 = 1;
    const WINDOWSAPPSDK_RUNTIME_VERSION_REVISION: u32 = 0;
    const WINDOWSAPPSDK_RUNTIME_VERSION_UINT64: u64 = 0x0002_0000_0001_0000;
    
    #[encoding("utf-16")]
    const WINDOWSAPPSDK_RELEASE_VERSION_TAG_W: String = "";
}

